# ---- 敏感信息（严禁入库）----
.env
.env.*
!.env.example

# ---- 真实配置（模板 config.example/ 入库）----
config/
!config.example/

# ---- 行情数据与元数据 ----
# 只忽略项目根目录的数据湖（/data/），避免误伤 backend/app/data/ 源码模块
/data/
*.db
*.sqlite3
*.parquet

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
# 测试临时目录：pytest/conftest 若把 tempfile.gettempdir() 解析成相对路径，
# 会落在仓库内（历史事故：backend/quant_test_data_*、backend/pytest-of-*）
quant_test_data_*/
pytest-of-*/

# ---- 前端 ----
node_modules/
dist/

# ---- 其他 ----
logs/
*.log
.DS_Store
Thumbs.db
.trae-browser-screenshots/

# ---- AI agent 本地工作区（一次性脚本与中间产物，不入库）----
.workbuddy/
# scripts/experiments/ 里已入库的 48 个历史脚本仍受 git 跟踪；新丢进去的 _*.py 不入库
/scripts/experiments/_*.py
