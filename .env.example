# =====================================================
# 环境变量模板：复制为 .env 并填写，.env 严禁提交入库
# =====================================================

# ---- LLM（按需填写，AI 分析功能依赖）----
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OLLAMA_API_KEY=ollama

# ---- 应用 ----
# JWT 密钥：openssl rand -hex 32 生成，固定后重启不失效
JWT_SECRET=
# 管理员账号（默认 admin / admin123，生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 数据目录（默认 <项目根>/data，一般无需修改）----
# DATA_DIR=
# CONFIG_DIR=

# ---- 定时任务（每日 16:10 数据增量更新，默认关闭）----
# ENABLE_SCHEDULER=0

# ---- 通知（可选）----
WXPUSH_TOKEN=
