# =====================================================
# 环境变量模板：复制为 .env 并填写，.env 严禁提交入库
# =====================================================

# ---- LLM（推荐登录后在「Key 管理」页配置，无需改此文件）----
# 前端 Key 管理支持 DeepSeek/OpenRouter/火山方舟/智谱/硅基流动/Ollama/自定义端点，
# 每用户私有、多 key 按优先级跨服务商自动轮换。
# 以下为系统级公共兜底池（用户无私有 Key 时使用），格式 provider|key 或 provider|model|key：
# LLM_KEY_1=deepseek|sk-xxx
# LLM_KEY_2=openrouter|deepseek/deepseek-chat|sk-or-yyy
# LLM_KEY_3=custom|https://api.xxx.com/v1|my-model|sk-zzz

DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OLLAMA_API_KEY=ollama

# ---- 应用 ----
# JWT 密钥：openssl rand -hex 32 生成，固定后重启不失效
JWT_SECRET=
# 管理员账号（默认 admin / admin123，生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 数据目录（默认 <项目根>/data，一般无需修改）----
# DATA_DIR=
# CONFIG_DIR=

# ---- 定时任务（每日 16:10 数据增量更新，默认关闭）----
# ENABLE_SCHEDULER=0

# ---- 通知（可选）----
WXPUSH_TOKEN=
